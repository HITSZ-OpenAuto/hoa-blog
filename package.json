{
  "name": "hoa-blog",
  "version": "1.0.0",
  "description": "HITSZ OpenAuto blog content repository",
  "type": "module",
  "scripts": {
    "lint": "eslint 'blog/**/*.mdx'",
    "lint:fix": "eslint 'blog/**/*.mdx' --fix",
    "lint:remark": "remark 'blog/**/*.mdx' --quiet --frail",
    "lint:remark:fix": "remark 'blog/**/*.mdx' --quiet --output",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.2.1",
    "eslint-mdx": "^3.7.0",
    "eslint-plugin-mdx": "^3.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-preset-lint-consistent": "^6.0.1"
  },
  "lint-staged": {
    "*.{md,mdx}": [
      "eslint --fix",
      "eslint"
    ],
    "*.mdx": [
      "remark --quiet --frail"
    ]
  },
  "packageManager": "pnpm@11.0.0-rc.5+sha512.c469fb6aa13a99e57aec935cd7b86ff422701f4602ecac2231d3dc20910586ebfb6b50a7b455d0778ec22ae56912d8d8e88e9f9e0a03c0875a6a41783a94a1bd"
}
